# Explicitly version owner-supplied test fixtures under TEST_ROMS only.
# ROMs elsewhere remain ignored. Review redistribution rights before public publishing.
!/TEST_ROMS/
!/TEST_ROMS/**/*.nes
!/TEST_ROMS/**/*.NES
!/TEST_ROMS/**/*.fds
!/TEST_ROMS/**/*.nsf
!/TEST_ROMS/**/*.unif
!/TEST_ROMS/**/nestest.log

# GitHub README assets (runtime PNG captures remain ignored)
!/assets/
!/assets/screenshots/
!/assets/screenshots/accuracycoin-147-of-147.png
