  <name>CipherNES</name>
  <summary>Native NES and Famicom emulator</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.hodgkinsstudios">
    <name>HodgkinsStudios</name>
  </developer>
  <description>
    <p>
      CipherNES is a native C++ NES and Famicom emulator with an NTSC timing
      target, broad built-in mapper support, save states, Game Genie support,
      gamepad configuration, screenshots, recording, TAS input tools, and
      Famicom Disk System support with a user-supplied BIOS.
    </p>
  </description>
